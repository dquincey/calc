#include <ftxui/dom/elements.hpp>
#include <ftxui/dom/node.hpp>
#include <ftxui/ftxui.hpp>
#include <ftxui/screen/color.hpp>
#include <ftxui/screen/screen.hpp>

using namespace ftxui;
int main() {
    auto hello = window(text("The window"), vbox({text("The element") | border, filler() | border,
                                                  text("Another one") | border, gauge(0.5) | border}));
    auto screen = ftxui::Screen::Create(ftxui::Dimension::Full(), // Use full terminal width
                                        ftxui::Dimension::Full()  // Fixed height of 10 rows
    );

    ftxui::Render(screen, hello);
    screen.Print();
    return 0;
}
